{
  "schemaVersion": 1,
  "id": "studio",
  "version": "${version}",
  "name": "Studio",
  "description": "Pressione Ctrl+O para alternar instantaneamente para a dimensao Studio. Pressione de novo para voltar.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.studio.Studio"],
    "client": ["com.studio.client.StudioClient"]
  },
  "mixins": [
    { "config": "studio.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
